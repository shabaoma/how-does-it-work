---
layout: layouts/topic.njk
english: true
pagination:
  data: englishTopics
  size: 1
  alias: englishTopic
permalink: "en/{{ englishTopic.url }}"
eleventyComputed:
  title: "{{ englishTopic.title }}"
  heading: "{{ englishTopic.title }}"
  lead: "{{ englishTopic.lead }}"
  description: "{{ englishTopic.description }}"
  footer: "{{ englishTopic.footer }}"
---
<main>
  <section class="panel">
    <p class="kicker">OVERVIEW</p>
    <h2>Overview</h2>
    <div class="diagram mermaid">{{ englishTopic.overview }}</div>
    <p class="callout">{{ englishTopic.overviewNote }}</p>
  </section>
  {% include "parts/steps.njk" %}
  <section class="panel supplement">
    <h2>Key boundaries</h2>
    <p>{{ englishTopic.extra }}</p>
  </section>
</main>
