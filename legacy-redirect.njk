---
pagination:
  data: legacyPages
  size: 1
  alias: legacyPage
permalink: "{{ legacyPage.url }}"
---
<!doctype html>
<html lang="{{ legacyPage.lang }}">
<head>
  <meta charset="utf-8">
  {% if legacyPage.url == 'index.html' %}<meta name="google-site-verification" content="WNZPcnzo-j4Z1MqM-Fl12Q0Bx22BrU_TfOUVIWO-QkU">{% endif %}
  <meta http-equiv="refresh" content="0; url={{ legacyPage.target }}">
  <meta name="robots" content="noindex">
  <title>{% if legacyPage.lang == 'en' %}Page moved{% else %}页面已迁移{% endif %}</title>
  <script>location.replace({{ legacyPage.target | jsonForScript | safe }} + location.search + location.hash);</script>
</head>
<body><p>{% if legacyPage.lang == 'en' %}This page has moved. Visit the <a href="{{ legacyPage.target }}">new address</a>.{% else %}页面已迁移，请访问<a href="{{ legacyPage.target }}">新地址</a>。{% endif %}</p></body>
</html>
