<div class="step-heading"><h2>{% if english %}Step by step{% else %}分步讲解{% endif %}</h2><p id="step-progress" aria-live="polite" aria-atomic="true"></p></div>
<div class="steps" id="steps" role="group" aria-label="{% if english %}Flow steps{% else %}流程步骤{% endif %}"></div>
<div class="navs">
  <button class="nav" id="prev" type="button">{% if english %}Previous{% else %}上一步{% endif %}</button>
  <button class="nav" id="next" type="button">{% if english %}Next{% else %}下一步{% endif %}</button>
</div>
<div class="layout">
  <section class="panel" aria-labelledby="step-title">
    <p class="kicker" id="kicker"></p>
    <h2 id="step-title"></h2>
    <div class="diagram" id="sequence" aria-busy="true"></div>
  </section>
  <section class="panel" aria-labelledby="detail-title">
    <h2 id="detail-title">{% if english %}What happens in this step{% else %}这一步发生了什么{% endif %}</h2>
    <p id="detail"></p>
    {% if hasTokens %}<div class="tokens" id="tokens"></div>{% endif %}
    <div class="callout" id="note"></div>
  </section>
</div>
