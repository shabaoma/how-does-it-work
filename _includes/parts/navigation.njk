<nav class="site" aria-label="{{ locale.ui.navigation }}">
  <a class="site-home" href="index.html"{% if currentUrl == 'index.html' %} aria-current="page"{% endif %}><span class="home-icon" aria-hidden="true">⌂</span>{{ locale.ui.home }}</a>
  {% for group in locale.menuGroups %}
  <div class="site-group"><span class="site-category">{{ group.category }}</span><div class="site-links">
    {% for topic in group.topics %}<a href="{{ topic.url }}"{% if currentUrl == topic.url %} aria-current="page"{% endif %}>{{ topic.label }}</a>{% endfor %}
  </div></div>
  {% endfor %}
</nav>
