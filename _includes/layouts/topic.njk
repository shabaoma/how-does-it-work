<!doctype html>
<html lang="{% if english %}en{% else %}zh-CN{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="stylesheet" href="{% if english %}../{% endif %}assets/css/site.css">
  {% if topicScript or englishTopic %}
  <script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
  {% if englishTopic %}<script>window.topicData = {{ englishTopic | jsonForScript | safe }};</script>{% else %}<script defer src="assets/js/topics/{{ topicScript }}.js"></script>{% endif %}
  <script defer src="{% if english %}../{% endif %}assets/js/steps.js"></script>
  {% endif %}
</head>
<body>
  <div class="site-layout">
    <aside class="sidebar">
      <div class="sidebar-menu sidebar-desktop">
        <div class="sidebar-heading">
          <div><p class="sidebar-eyebrow">{% if english %}GUIDE{% else %}知识目录{% endif %}</p><h2 class="sidebar-title">{% if english %}Explore topics{% else %}探索技术原理{% endif %}</h2></div>
          <span class="sidebar-count">{% if english %}{{ englishTopics | length }} topics{% else %}{{ topics | length }} 个主题{% endif %}</span>
        </div>
        {% include "parts/navigation.njk" %}
      </div>
      <details class="sidebar-menu sidebar-mobile">
        <summary><span class="mobile-menu-icon" aria-hidden="true"><span></span></span><span>{% if english %}Topics{% else %}主题目录{% endif %}</span><span class="sidebar-current">{% if english %}{{ englishTopic.label or 'Home' }}{% elif topicScript %}{{ heading }}{% else %}首页{% endif %}</span></summary>
        {% include "parts/navigation.njk" %}
      </details>
    </aside>
    <div class="page-content">
      <header>
        <div class="language-switch" aria-label="{% if english %}Language{% else %}语言{% endif %}">
          {% if english %}<a href="../{{ englishTopic.url or 'index.html' }}" lang="zh-CN">简体中文</a><span aria-current="true" lang="en">English</span>{% else %}<span aria-current="true" lang="zh-CN">简体中文</span><a href="en/{{ page.fileSlug if topicScript else 'index' }}.html" lang="en">English</a>{% endif %}
        </div>
        <h1>{{ heading }}</h1>
        <p class="lead">{{ lead | safe }}</p>
      </header>
      {{ content | safe }}
      <footer>{{ footer | safe }}</footer>
    </div>
  </div>
</body>
</html>
